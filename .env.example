# Google Gemini API key for Gemma 4 models
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemma model identifier on Google Gemini API
# Supported models include: gemma-4-31b-it, gemma-4-26b-a4b-it, gemma-4-4b-it
GEMMA_MODEL=gemma-4-31b-it

# Optional: Perplexity API key for live raw-material market prices
# If left empty, the application seamlessly falls back to manual price input
PERPLEXITY_API_KEY=

# Backend server port
PORT=3001

